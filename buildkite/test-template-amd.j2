{% set default_working_dir = "/vllm-workspace/tests" %}
{% set default_amd_timeout_in_minutes = 180 %}
{% set list_file_diff = list_file_diff | replace("\r", "") | replace("\n", "|") | split("|") %}
{# TODO: Re-enable after validating the ROCm debug agent setup.
{% set rocm_debug_agent_setup = "if test -f /opt/rocm/lib/librocm-debug-agent.so.2; then export HSA_TOOLS_LIB=/opt/rocm/lib/librocm-debug-agent.so.2 && export HSA_ENABLE_DEBUG=1 && echo ROCm debug agent enabled: /opt/rocm/lib/librocm-debug-agent.so.2; else echo 'WARNING: ROCm debug agent not found at /opt/rocm/lib/librocm-debug-agent.so.2; skipping coredump setup'; fi" %}
#}
{% set rocm_debug_agent_setup = "echo 'ROCm debug agent disabled; re-enable rocm_debug_agent_setup in test-template-amd.j2 after validating coredump setup'" %}

{% macro amd_infra_retry(indent='', retry_exit_status_one=false) -%}
{{ indent }}retry:
{{ indent }}  automatic:
{{ indent }}    - signal_reason: stack_error  # Kubernetes pod/stack provisioning failed
{{ indent }}      limit: 1
{% if retry_exit_status_one %}
{{ indent }}    - exit_status: 1  # Transient Docker/BuildKit failure
{{ indent }}      limit: 1
{{ indent }}    - exit_status: 2  # Exact image found but registry handoff failed
{{ indent }}      limit: 1
{% endif %}
{{ indent }}    - signal_reason: agent_stop  # Agent host stopped unexpectedly
{{ indent }}      limit: 1
{{ indent }}    - signal_reason: agent_refused  # Agent could not accept the job
{{ indent }}      limit: 1
{{ indent }}    - exit_status: -1  # Lost contact with the running agent
{{ indent }}      signal_reason: none
{{ indent }}      limit: 1
{{ indent }}    - exit_status: 134  # ROCm/KFD GPU hang (SIGABRT)
{{ indent }}      limit: 1
{%- endmacro %}

{% macro amd_step_slug(step) -%}
{%- set slug -%}
{%- if step.agent_pool -%}{{ step.agent_pool }}-{%- endif -%}{{ step.label | replace(" ", "-") | lower | replace("(", "") | replace(")", "") | replace("%", "") | replace(",", "-") | replace("+", "-") }}
{%- endset -%}
{# Preserve existing valid slugs; replace any remaining invalid key characters. #}
{%- for char in slug -%}
{{- char if char in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_:-" else "-" -}}
{%- endfor -%}
{%- endmacro %}

{# Per-build test image (runtime-ci plus one vLLM layer) pushed by image-build-amd.
   Native pods (container-0 via podSpecPatch) and DinD jobs both run it. #}
{% macro amd_ci_image() -%}
rocm/vllm-ci:build-$BUILDKITE_BUILD_ID
{%- endmacro %}

{% macro amd_native_k8s_plugin(step) %}
        plugins:
          - kubernetes:
              podSpecPatch:
                automountServiceAccountToken: false
                securityContext:
                  seccompProfile:
                    type: RuntimeDefault
                imagePullSecrets:
                  - name: docker-config
                containers:
                  - name: container-0
                    image: {{ amd_ci_image() | safe }}
                    imagePullPolicy: IfNotPresent
                    securityContext:
                      allowPrivilegeEscalation: false
                      capabilities:
                        add:
                          - IPC_LOCK
                    {# DPX agents allocate one partition via DRA resourceClaims on the
                       controller. Setting amd.com/gpu here creates a second claim #}
                    {% if "dpx" not in step.agent_pool %}
                    resources:
                      limits:
                        {% if step.no_gpu %}
                        {# Explicit zero overrides the typed controller PodSpec's inherited GPU request. #}
                        amd.com/gpu: "0"
                        {% else %}
                        amd.com/gpu: "{{ step.num_gpus or 1 }}"
                        {% endif %}
                      requests:
                        {% if step.no_gpu %}
                        amd.com/gpu: "0"
                        {% else %}
                        amd.com/gpu: "{{ step.num_gpus or 1 }}"
                        {% endif %}
                    {% endif %}
                    volumeMounts:
                      - name: devshm
                        mountPath: /dev/shm
                      - name: vllm-workspace
                        mountPath: /vllm-workspace
                    env:
                      - name: AMD_CI_RUNTIME
                        value: native
                      - name: NATIVE_CI
                        value: "true"
                      - name: VLLM_CI_DOCKER_DISABLED
                        value: "1"
                      - name: VLLM_CI_EXPECTED_GPU_COUNT
                        value: "{{ 0 if step.no_gpu else (step.num_gpus or 1) }}"
                      - name: VLLM_CI_WORKSPACE
                        value: /vllm-workspace
                      - name: VLLM_CI_REQUIRE_WORKSPACE_MOUNT
                        value: "1"
                      - name: PYTORCH_ROCM_ARCH
                        value: ""
                      # Correlate in-pod GPU/BDF diagnostics with the K8s host.
                      - name: VLLM_CI_K8S_POD_NAME
                        valueFrom:
                          fieldRef:
                            fieldPath: metadata.name
                      - name: VLLM_CI_K8S_NAMESPACE
                        valueFrom:
                          fieldRef:
                            fieldPath: metadata.namespace
                      - name: VLLM_CI_K8S_NODE_NAME
                        valueFrom:
                          fieldRef:
                            fieldPath: spec.nodeName
                volumes:
                  - name: devshm
                    emptyDir:
                      medium: Memory
                      sizeLimit: 16Gi
                  - name: vllm-workspace
                    emptyDir: {}
{%- endmacro %}

  - group: "AMD Tests"
    depends_on: ~
    steps:
      {# Content-keyed runtime image (wheelhouse + runtime-ci); built only on a miss. #}
      - label: "AMD: :docker: build ROCm runtime"
        depends_on: ~
        soft_fail: false
        commands:
          - bash .buildkite/scripts/rocm/build-runtime.sh
        key: "build-rocm-runtime-amd"
        concurrency: 1
        concurrency_group: "vllm/rocm/runtime-build/$BUILDKITE_COMMIT"
        timeout_in_minutes: 540
        env:
          DOCKER_BUILDKIT: "1"
          BUILDKIT_PROGRESS: "tty"
          TERM: "xterm-256color"
          PYTORCH_ROCM_ARCH: "gfx90a;gfx942;gfx950"
{{ amd_infra_retry('        ', true) }}
        agents:
          queue: amd-cpu

      - label: "AMD: :docker: build test image"
        depends_on: "build-rocm-runtime-amd"
        soft_fail: false
        commands:
          - bash .buildkite/scripts/rocm/build-test-image.sh
          - bash .buildkite/scripts/rocm/smoke-test-image.sh
        key: "image-build-amd"
        timeout_in_minutes: {{ default_amd_timeout_in_minutes }}
        env:
          DOCKER_BUILDKIT: "1"
          BUILDKIT_PROGRESS: "tty"
          TERM: "xterm-256color"
          VLLM_BAKE_FILE: "docker/docker-bake-rocm.hcl"
          PYTORCH_ROCM_ARCH: "gfx90a;gfx942;gfx950"
          IMAGE_TAG: "{{ amd_ci_image() | safe }}"
          REMOTE_VLLM: "0"
{{ amd_infra_retry('        ', true) }}
        agents:
          queue: amd-cpu

    {% for step in steps %}
    {% if step.mirror_hardwares and mirror_hw in step.mirror_hardwares %}

    {% set ns = namespace(blocked=1) %}
    {% set step_slug = amd_step_slug(step) %}
    {% set requested_timeout_in_minutes = step.timeout_in_minutes or default_amd_timeout_in_minutes %}
    {% set step_timeout_in_minutes = requested_timeout_in_minutes if requested_timeout_in_minutes <= default_amd_timeout_in_minutes else default_amd_timeout_in_minutes %}
    {# Time out the container a minute before Buildkite times out the job. #}
    {% set container_timeout_s = (step_timeout_in_minutes * 60 - 60) if step_timeout_in_minutes > 1 else step_timeout_in_minutes * 60 %}

    {% if run_all == "1" or nightly == "1" %}
    {% set ns.blocked = 0 %}
    {% endif %}

      {% if step.source_file_dependencies %}
        {% for source_file in step.source_file_dependencies %}
          {% for file in list_file_diff %}
            {% if file and file[:source_file|length] == source_file %}
              {% set ns.blocked = 0 %}
            {% endif %}
          {% endfor %}
        {% endfor %}
        {% if step.dind == false %}
          {% for file in list_file_diff %}
            {% if file == ".buildkite/scripts/hardware_ci/run-amd-test.sh" %}
              {% set ns.blocked = 0 %}
            {% endif %}
          {% endfor %}
        {% endif %}
      {% else %}
        {% set ns.blocked = 0 %}
      {% endif %}

      {% set step_gated = (ns.blocked == 1 or (step.optional and nightly != "1")) and not (step.autorun_on_main == true and branch == "main") %}
      {% if step_gated %}
      - block: "Run {{ step.agent_pool }}: {{ step.label }}"
        depends_on: image-build-amd
        key: block-{{ step_slug }}
      {% endif %}

      - label: "{{ step.agent_pool }}: {{ step.label }}"
        {% if step_gated %}
        depends_on: block-{{ step_slug }}
        {% else %}
        depends_on: image-build-amd
        {% endif %}
        timeout_in_minutes: {{ step_timeout_in_minutes }}
        agents:
          queue: amd_{{ step.agent_pool }}
          {% if step.dind == false and step.agent_tags %}
            {% for key, value in step.agent_tags | items %}
              {% if key != "queue" and key and value %}
          {{ key }}: "{{ value }}"
              {% endif %}
            {% endfor %}
          {% endif %}
        {% if step.dind == false %}
{{ amd_native_k8s_plugin(step) }}
        {% endif %}
        {% if step.no_plugin %}
        command: {{ (step.command or (step.commands | join(' && '))) | safe }}
        {% if step.env %}
        env:
          {% for key, value in step.env | items %}
          {{ key }}: {{ value | safe }}
          {% endfor %}
        {% endif %}
        {% else %}
        command: bash .buildkite/scripts/hardware_ci/run-amd-test.sh
        artifact_paths:
          - "artifacts/amd-gpu-diagnostics/*/diagnostics.log"
        env:
          BUILDKITE_ARTIFACT_UPLOAD_SKIP_SYMLINKS: "true"
          NUM_NODES: "{{ step.num_nodes or 1 }}"
          {% if step.dind == false %}
          AMD_CI_RUNTIME: "native"
          NATIVE_CI: "true"
          VLLM_CI_DOCKER_DISABLED: "1"
          # The Python-only job downloads the wheel from this step.
          VLLM_CI_ARTIFACT_STEP: "image-build-amd"
          VLLM_CI_REQUIRE_PERSISTENT_HF_CACHE: "1"
          VLLM_CI_WORKSPACE: "/vllm-workspace"
          VLLM_CI_REQUIRE_WORKSPACE_MOUNT: "1"
          HF_HOME: "/home/buildkite-agent/huggingface"
          HF_HUB_DOWNLOAD_TIMEOUT: "300"
          HF_HUB_ETAG_TIMEOUT: "60"
          PYTORCH_ROCM_ARCH: ""
          {% else %}
          # Agent hooks and run-amd-test.sh both read DOCKER_IMAGE_NAME.
          DOCKER_IMAGE_NAME: "{{ amd_ci_image() | safe }}"
          {% endif %}
          VLLM_CI_RESULTS_ROOT: "/home/buildkite-agent/huggingface/amd-ci-results"
          # Keep failure diagnostics out of shared HF/NFS storage.
          VLLM_CI_DIAGNOSTICS_DIR: "artifacts/amd-gpu-diagnostics"
          VLLM_CI_EXPECTED_GPU_COUNT: "{{ 0 if step.no_gpu else (step.num_gpus or 1) }}"
          {% if container_timeout_s %}
          CONTAINER_TIMEOUT_S: "{{ container_timeout_s }}"
          {% endif %}
          {% if step.num_nodes and step.num_nodes >= 2 %}
          VLLM_CI_EXECUTION_MODE: "multi-node"
          VLLM_NUM_GPUS_PER_NODE: "{{ step.num_gpus or 1 }}"
          VLLM_NODE_COMMAND_COUNT: "{{ step.commands | length }}"
          {% for node_command in step.commands %}
          VLLM_NODE_COMMAND_{{ loop.index0 }}: "(command rocm-smi || true) && {{ rocm_debug_agent_setup | safe }} && cd {{ (step.working_dir or default_working_dir) | safe }} && {{ node_command | replace('\"', '\\\"') | safe }}"
          {% endfor %}
          {% else %}
          VLLM_CI_EXECUTION_MODE: "single-node"
          VLLM_TEST_COMMANDS: "(command rocm-smi || true) && {{ rocm_debug_agent_setup | safe }} && cd {{ (step.working_dir or default_working_dir) | safe }} && {{ (step.command or (step.commands | join(' && '))) | replace('\"', '\\\"') | safe }}"
          {% endif %}
        {% endif %}
        priority: 100
        {% if step.parallelism %}
        parallelism: {{ step.parallelism }}
        {% endif %}
{{ amd_infra_retry('        ') }}
    {% endif %}
    {% endfor %}
